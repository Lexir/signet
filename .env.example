# Профиль: local (дефолт) или prod
SPRING_PROFILES_ACTIVE=prod

# --- OpenAI ---
OPENAI_API_KEY=

# --- Ящик поддержки (один аккаунт для IMAP-чтения и SMTP-отправки) ---
IMAP_HOST=imap.provider.com
SMTP_HOST=smtp.provider.com
MAIL_USER=support@company.com
MAIL_PASS=

# --- Telegram ---
TG_BOT_TOKEN=
TG_MANAGER_CHAT_ID=

# --- База данных ---
DB_USER=signet
DB_SCHEMA=signet
DB_PASS=

# --- Дашборд (basic auth) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=

# --- Обязательно для профиля prod ---
# Ключ шифрования секретов в БД (пароли ящиков, токен бота, ключ OpenAI).
# Сгенерировать:  openssl rand -hex 32
# ВНИМАНИЕ: при смене ключа все уже сохранённые секреты станут нечитаемыми —
# их придётся заново ввести на /settings.
SETTINGS_SECRET_KEY=

# SPRING_DATASOURCE_URL задаётся в docker-compose.yml; здесь нужен,
# только если запускаете prod-профиль без compose.

# --- TLS / HTTPS ---
# Проще всего: install.sh спросит домен и сам выпустит сертификат (certbot).
# COOKIE_SECURE: true по HTTPS, false для входа по голому http (отладка).
# install.sh управляет этим сам; вручную — см. nginx/default.conf.
COOKIE_SECURE=false

# --- Необязательное ---
# Ollama на хосте (в контейнере localhost — это сам контейнер)
OLLAMA_BASE_URL=http://host.docker.internal:11434
